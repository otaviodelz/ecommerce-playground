{
  "name": "ecommerce-playground",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "node scripts/run-zones.mjs dev",
    "build": "node scripts/build.mjs",
    "start": "node scripts/run-zones.mjs start",
    "stop": "node scripts/run-zones.mjs stop",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "storybook": "pnpm --filter @playground/storybook dev",
    "storybook:build": "pnpm --filter @playground/storybook build"
  },
  "devDependencies": {
    "turbo": "^2.11.11"
  }
}
